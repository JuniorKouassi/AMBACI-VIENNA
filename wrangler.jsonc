{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ambacivienna",
  "compatibility_date": "2026-06-19",
  "main": "worker/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ambaci-bookings",
      "database_id": "330b6116-0267-4a88-8c77-782e41c89ab6"
    }
  ],
  // Private bucket for the documents citizens send before their appointment.
  // Kept commented out until the bucket exists, so that deploying cannot fail. To switch the
  // dossier feature on (see also DOSSIERS_ENABLED below):
  //   1. npx wrangler r2 bucket create ambaci-dossiers
  //   2. uncomment the block below
  //   3. npx wrangler d1 execute ambaci-bookings --remote --file=migrations/0002_dossiers.sql
  //   4. npx wrangler secret put DOSSIER_LINK_SECRET   (same value on the administration platform)
  //   5. set DOSSIERS_ENABLED to "true" and deploy
  "r2_buckets": [
    {
      "binding": "DOSSIERS",
      "bucket_name": "ambaci-dossiers"
    }
  ],
  // Erases expired dossiers every day at 03:15 UTC.
  "triggers": {
    "crons": ["15 3 * * *"]
  },
  "vars": {
    // The document pre-submission feature is invisible until this is "true" AND the secret
    // below is set:  npx wrangler secret put DOSSIER_LINK_SECRET  (same value on the
    // administration platform, which e-mails the citizens' personal links).
    "DOSSIERS_ENABLED": "true"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
